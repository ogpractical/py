Q2. Write a python program to list all files in a current directory. Display total count of .py files and content of any one .py file.

import os

# Get current directory
current_dir = os.getcwd()

# List all files
files = os.listdir(current_dir)

print("All Files:")
print(files)

# Filter .py files
py_files = [file for file in files if file.endswith(".py")]

# Count .py files
print("\nTotal .py files:", len(py_files))

# Display content of one .py file
if py_files:
    print("\nContent of file:", py_files[0])
    with open(py_files[0], 'r') as f:
        print(f.read())
else:
    print("No .py files found.")


