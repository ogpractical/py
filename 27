Q2. Validate password based on given criteria

[20 Marks]

# Q2 Solution

import re

password = input("Enter password: ")

# Regex pattern:
# At least one lowercase letter, one digit, one special char ($#@)
# Length between 6 and 12

pattern = r'^(?=.*[a-z])(?=.*[0-9])(?=.*[$#@]).{6,12}$'

if re.match(pattern, password):
    print("Valid Password")
else:
    print("Invalid Password")


