Q1. Generate random radius and compute circumference of a circle

[10 Marks]

# Q1 Solution

import random
import math

# Generate random radius between 1 and 10
radius = random.randint(1, 10)

# Calculate circumference (2 * π * r), π = 3.14
circumference = 2 * 3.14 * radius

print("Random Radius:", radius)
print("Circumference of circle:", circumference)


