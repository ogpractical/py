Q2. List files in directory, count .py files and display content of one file

[20 Marks]

# Q2 Alternative Solution

import os

# Get current directory
path = os.getcwd()

# List all files
files = os.listdir(path)

print("Files in current directory:\n")
for f in files:
    print(f)

# Count .py files
py_files = [f for f in files if f.endswith('.py')]
print("\nTotal .py files:", len(py_files))

# Display content of one .py file
if py_files:
    filename = py_files[0]
    print(f"\nDisplaying content of {filename}:\n")
    
    with open(filename, 'r') as file:
        print(file.read())
else:
    print("No .py files found.")


