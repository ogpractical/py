Q2. Program to calculate pass/fail status of students

[20 Marks]

# Q2 Solution

# Function to check pass/fail
def check_pass_fail(marks):
    if marks >= 40:
        return "Pass"
    else:
        return "Fail"

# Input number of students
n = int(input("Enter number of students: "))

pass_count = 0
fail_count = 0

# Loop for each student
for i in range(n):
    marks = int(input(f"Enter marks for student {i+1}: "))
    
    result = check_pass_fail(marks)
    print(f"Student {i+1}: {result}")
    
    if result == "Pass":
        pass_count += 1
    else:
        fail_count += 1

# Display totals
print("\nTotal Passed:", pass_count)
print("Total Failed:", fail_count)


