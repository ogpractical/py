Q2. Create a Web Page using Flask for Library Book List

[20 Marks]

Step 1: app.py

from flask import Flask, render_template

app = Flask(__name__)

@app.route('/')
def home():
    library_name = "My Library"

    books = [
        {"title": "Python Basics", "author": "John Doe"},
        {"title": "Data Structures", "author": "Jane Smith"},
        {"title": "Algorithms", "author": "Alice Brown"}
    ]

    quote = "Reading is to the mind what exercise is to the body."

    return render_template("index.html",
                           library_name=library_name,
                           books=books,
                           quote=quote)

if __name__ == '__main__':
    app.run(debug=True)


