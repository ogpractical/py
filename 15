Q1. Write a Python program to demonstrate time module functions

[10 Marks]

# Q1 Solution

import time

# Get current time in seconds
seconds = time.time()
print("Current time in seconds:", seconds)

# a) Convert seconds to struct_time in UTC
utc_time = time.gmtime(seconds)
print("\nUTC struct_time:", utc_time)

# b) Convert struct_time to formatted string
formatted_time = time.strftime("%Y-%m-%d %H:%M:%S", utc_time)
print("Formatted UTC time:", formatted_time)


