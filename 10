# interest.py

def cal_interest(amount, year):
    rate = 0.05   # 5%
    si = (amount * rate * year)
    return si


---

Step 3: currency.py

# currency.py

def convert(amount):
    rate = 0.012   # INR to USD
    usd = amount * rate
    return usd


