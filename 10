Q2. Write a Python program to create a class that acts as an iterator and generates factorial series up to n (1! + 2! + ... + n!)

[20 Marks]

# Q2 Alternative Solution

class FactorialSeries:
    def __init__(self, n):
        self.n = n
        self.current = 1

    def __iter__(self):
        return self

    def __next__(self):
        if self.current > self.n:
            raise StopIteration

        fact = 1
        for i in range(1, self.current + 1):
            fact *= i

        result = fact
        self.current += 1
        return result


# Input from user
n = int(input("Enter value of n: "))

fs = FactorialSeries(n)

print("Factorial Series:")
total = 0

for val in fs:
    print(val, end=" ")
    total += val

print("\nSum of series =", total)


