Q2. Validate mobile number based on given criteria

[20 Marks]

# Q2 Alternative Solution

import re

mobile = input("Enter mobile number: ")

# Regex:
# Optional 0 or 91 at start
# First digit 6-9
# Remaining 9 digits

pattern = r'^(0|91)?[6-9][0-9]{9}$'

if re.match(pattern, mobile):
    print("Valid mobile number")
else:
    print("Invalid mobile number")


