Q1. Shuffle a deck of cards and display 5 attempts

[10 Marks]

# Q1 Solution

import random

# Create a deck of cards
suits = ['Hearts', 'Diamonds', 'Clubs', 'Spades']
ranks = ['2', '3', '4', '5', '6', '7', '8', '9', '10',
         'Jack', 'Queen', 'King', 'Ace']

deck = [(rank, suit) for suit in suits for rank in ranks]

# Shuffle deck
random.shuffle(deck)

# Display 5 cards (attempts)
print("Cards drawn in 5 attempts:\n")

for i in range(5):
    card = deck[i]
    print(f"Attempt {i+1}: {card[0]} of {card[1]}")


