Q1. Create a DataFrame from dictionary and display first 5 and last 5 rows

[10 Marks]

# Q1 Solution

import pandas as pd

# Create dictionary
data = {
    "Subject_Name": ["Maths", "Physics", "Chemistry", "Biology", "English",
                     "History", "Geography", "Computer", "Economics", "Hindi"],
    "Marks": [85, 78, 82, 88, 75, 80, 77, 90, 84, 79]
}

# Create DataFrame
df = pd.DataFrame(data)

# Display DataFrame
print("DataFrame:\n", df)

# First 5 rows
print("\nFirst 5 rows:\n", df.head())

# Last 5 rows
print("\nLast 5 rows:\n", df.tail())


