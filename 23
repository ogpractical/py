Q1. Function productInfo() with default price

[10 Marks]

# Q1 Solution

def productInfo(name, price=100):
    if price < 100:
        print("Product Name:", name)
    else:
        print("Price is not less than Rs.100")

# Input from user
name = input("Enter product name: ")
price_input = input("Enter price (press Enter for default): ")

# Handle default price
if price_input == "":
    productInfo(name)
else:
    productInfo(name, float(price_input))


