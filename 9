Q2. Write a python program using user define function to accept a number and perform the following task: a) Check number is Armstrong or not. b) Calculate and display sum of digits till single digit [e.g. -  558 = 18 = 9]


def armstrong(n):
    temp = n
    digits = len(str(n))
    s = 0    
    while temp > 0:
        rem = temp % 10
        s = s + (rem ** digits)
        temp = temp // 10
    if s == n:
        print(n, "is Armstrong Number")
    else:
        print(n, "is Not Armstrong Number")
def single_digit_sum(n):
    while n >= 10:
        s = 0
        while n > 0:
            rem = n % 10
            s = s + rem
            n = n // 10
        n = s
    print("Single Digit Sum =", n)
num = int(input("Enter a number: "))
armstrong(num)
single_digit_sum(num)
