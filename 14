Q2. Write a Python program to read file from a given byte position

[20 Marks]

# Q2 Solution

filename = input("Enter file name: ")
position = int(input("Enter byte position: "))

try:
    with open(filename, 'r') as file:
        file.seek(position)   # Move pointer to given byte position
        
        content = file.read() # Read from that position till end
        
        print("\nContent from given position:\n")
        print(content)

except FileNotFoundError:
    print("Error: File does not exist!")

except ValueError:
    print("Error: Invalid input!")


