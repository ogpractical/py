Q2. Validate mobile number using given criteria

[20 Marks]

# Q2 Solution

import re

mobile = input("Enter mobile number: ")

# Pattern explanation:
# ^(0|91)?  → optional 0 or 91 at beginning
# [6-9]     → first digit between 6–9
# [0-9]{9}$ → remaining 9 digits

pattern = r'^(0|91)?[6-9][0-9]{9}$'

if re.match(pattern, mobile):
    print("Valid mobile number")
else:
    print("Invalid mobile number")


