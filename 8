Q2. Create a Web Page using Flask which contains information about your college

[20 Marks]

Step 1: app.py

from flask import Flask, render_template

app = Flask(__name__)

@app.route('/')
def home():
    college_name = "ABC College"

    courses = ["BSc Computer Science", "BCom", "BA", "BCA"]

    return render_template("index.html",
                           college_name=college_name,
                           courses=courses)

if __name__ == '__main__':
    app.run(debug=True)


