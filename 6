Q2. Create a Web Page using Flask which contains following information about your Personal Portfolio Page a) Show your name as a centered heading. b) List your Qualification details. c) Add your special skill in scrolling.

from flask import Flask
app = Flask(__name__)
@app.route('/')
def portfolio():
    return """
    <html>
    <head>
        <title>Personal Portfolio</title>
    </head>
    <body>
        <!-- Centered Heading -->
        <h1 align="center">Sarthak More</h1>

        <!-- Qualification Details -->
        <h2>Qualification Details:</h2>
        <ul>
            <li>10th Pass</li>
            <li>12th Pass</li>
            <li>B.Sc Computer Science</li>
        </ul>

        <!-- Scrolling Skill -->
        <marquee behavior="scroll" direction="left">
            Special Skill: Python Programming | Web Development | Communication Skill
        </marquee>

    </body>
    </html>
    """

if __name__ == '__main__':
    app.run(debug=True)
