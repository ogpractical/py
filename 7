Q2. Write a python program to copy contents of one file into another file and display details

[20 Marks]

# Q2 Alternative Solution

source = input("Enter source file name: ")
destination = input("Enter destination file name: ")

try:
    with open(source, 'r') as f1:
        content = f1.read()

    with open(destination, 'w') as f2:
        f2.write(content)

    print("\nFile copied successfully!\n")

    # Display content of new file
    with open(destination, 'r') as f2:
        new_content = f2.read()
        print("New File Contents:\n")
        print(new_content)

        # Counts
        char_count = len(new_content)
        word_count = len(new_content.split())
        line_count = new_content.count('\n') + 1

        print("\nNumber of characters:", char_count)
        print("Number of words:", word_count)
        print("Number of lines:", line_count)

except FileNotFoundError:
    print("Error: Source file does not exist!")


