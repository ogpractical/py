Q2. Write a Python program to process string and find words without vowels

[20 Marks]

# Q2 Alternative Solution

string = input("Enter a string: ")

# Split into words
words = string.split()

vowels = "aeiouAEIOU"

# Find words without vowels
result = [word for word in words if not any(char in vowels for char in word)]

# Sort words alphabetically
result.sort()

print("Words without vowels (sorted):")
print(result)

# Count
print("Total count:", len(result))


