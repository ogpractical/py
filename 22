Q2. Write a Python program to create a class that acts as an iterator and generates the factorial series up to n (1! + 2! + 3! + … + n!). (Accept input from the user)

class FactorialSeries:
    def __init__(self, n):
        self.n = n
        self.num = 1
        self.fact = 1
    def __iter__(self):
        return self
    def __next__(self):
        if self.num <= self.n:
            self.fact = self.fact * self.num
            value = self.fact
            self.num += 1
            return value
        else:
            raise StopIteration
n = int(input("Enter value of n: "))
obj = FactorialSeries(n)
print("Factorial Series up to", n, ":")
for i in obj:
    print(i, end=" ")
