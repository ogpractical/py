Q2. Write a Python program for time operations

[20 Marks]

# Q2 Solution

import time
from datetime import datetime

# a) Current local time and UTC time
local_time = datetime.now()
utc_time = datetime.utcnow()

print("Local Time:", local_time)
print("UTC Time:", utc_time)

# b) Using ctime() and gmtime()
print("\nUsing ctime():", time.ctime())
print("Using gmtime():", time.gmtime())

# c) Accept date-time string
dt_string = input("\nEnter date-time (DD-MM-YYYY HH:MM:SS): ")

# d) Parse and format
dt_object = datetime.strptime(dt_string, "%d-%m-%Y %H:%M:%S")

# Format 1
format1 = dt_object.strftime("%Y/%m/%d %H:%M:%S")

# Format 2
format2 = dt_object.strftime("%A, %d %B %Y %I:%M:%S %p")

print("\nFormatted Date-Time 1:", format1)
print("Formatted Date-Time 2:", format2)


