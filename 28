Q1. Validate three-letter word pattern using Regular Expressions

[10 Marks]

# Q1 Solution

import re

string = input("Enter a word: ")

# Pattern: first letter c or m, second letter vowel, third letter t or d
pattern = r'^[cm][aeou][td]$'

if re.match(pattern, string):
    print("Valid pattern (matches given examples)")
else:
    print("Invalid pattern")


