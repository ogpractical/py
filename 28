Q2. Display all entries in current directory and identify file or folder

[20 Marks]

# Q2 Alternative Solution

import os

# Get current directory
path = os.getcwd()
print("Current Directory:", path)

# List entries
entries = os.listdir(path)

print("\nDirectory Contents:\n")

for entry in entries:
    if os.path.isfile(entry):
        print(entry, "- File")
    elif os.path.isdir(entry):
        print(entry, "- Folder")


