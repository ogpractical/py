Q2. Program using user-defined functions (Armstrong + sum of digits)

[20 Marks]

# Q2 Alternative Solution

# Function to check Armstrong number
def is_armstrong(num):
    temp = num
    digits = len(str(num))
    sum_val = 0

    while temp > 0:
        digit = temp % 10
        sum_val += digit ** digits
        temp //= 10

    return sum_val == num


# Function to reduce number to single digit sum
def sum_to_single_digit(num):
    while num >= 10:
        num = sum(int(d) for d in str(num))
    return num


# Input
n = int(input("Enter a number: "))

# Armstrong check
if is_armstrong(n):
    print("Number is Armstrong")
else:
    print("Number is NOT Armstrong")

# Sum till single digit
result = sum_to_single_digit(n)
print("Sum till single digit:", result)


